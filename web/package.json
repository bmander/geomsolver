{
  "name": "gcs-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Geometric constraint solver in the browser: Rust core compiled to WebAssembly, TypeScript binding, 3D-workspace sketcher.",
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/copy-wasm.js && node tools/copy-examples.js && npm run bundle",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "serve": "node tools/serve.js",
    "bench": "npm run build && node dist/test/bench.js",
    "bundle": "node tools/bundle.js",
    "overlay": "npm run build && node tools/overlay.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.185.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
