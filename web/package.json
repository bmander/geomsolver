{
  "name": "gcs-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Geometric constraint solver in the browser: C core compiled to WebAssembly, TypeScript front end, HTML5-canvas sketcher.",
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/copy-wasm.js",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "serve": "node tools/serve.js",
    "bench": "npm run build && node dist/test/bench.js"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
