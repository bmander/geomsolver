+/// Whether each face is measured and said on its own (MASS_FACES): a face that cannot be measured
+/// is said with its reason, and the faces after it are measured all the same.
+fn each_face() -> bool {
+    std::env::var_os("MASS_FACES").is_some()
+}
+
+/// Why a face could not be measured, in a word.
+fn why(e: &Err) -> String {
+    match e {
+        Err::Unsupported(s) | Err::Invalid(s) => s.clone(),
+        Err::Py(k, s) | Err::Uncaught(k, s) => format!("{}: {}", k, s),
+    }
+}
