unit mm
use std
front := plane hint(origin: (100000000, 0, 100000000))
fix(origin == (100000000, 0, 100000000)) front
fix(dir == (1, 0, 0)) front.u
fix(dir == (0, 0, 1)) front.v
resultfp0 := point in front
fix((0, 0)) resultfp0
resultfp1 := point in front
fix((10, 0)) resultfp1
resultfp2 := point in front
fix((10, 10)) resultfp2
resultfp3 := point in front
fix((0, 10)) resultfp3
resultf := face(resultfp0, resultfp1, resultfp2, resultfp3, -> close)
result := solid(resultf, from: -1mm, to: 0mm)
view(result) in front
