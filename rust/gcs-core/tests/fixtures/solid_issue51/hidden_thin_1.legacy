unit mm
use std
in std.front {
stockfp0 := point
fix((0, 0)) stockfp0
stockfp1 := point
fix((10, 0)) stockfp1
stockfp2 := point
fix((10, 10)) stockfp2
stockfp3 := point
fix((0, 10)) stockfp3
}
stockf := face(stockfp0, stockfp1, stockfp2, stockfp3, -> close)
stock := solid(stockf, from: -1mm, to: 0mm)
in std.front {
bossfp0 := point
fix((2, 2)) bossfp0
bossfp1 := point
fix((5, 2)) bossfp1
bossfp2 := point
fix((5, 5)) bossfp2
bossfp3 := point
fix((2, 5)) bossfp3
}
bossf := face(bossfp0, bossfp1, bossfp2, bossfp3, -> close)
boss := solid(bossf, from: 1mm, to: 2mm)
result := solid(stock)
boss union result
back := plane(u: std.back, v: std.z)
fix(origin == (0, 0, 0)) back
view(result) in back
