unit mm
o := point
fix(x == 0, y == 0) o
q := point
fix(x == 40, y == 0) q
front := plane(origin:o,toward:q)
resultfp0 := point in front
fix(x == 0, y == 0) resultfp0
resultfp1 := point in front
fix(x == 10, y == 0) resultfp1
resultfp2 := point in front
fix(x == 10, y == 10) resultfp2
resultfp3 := point in front
fix(x == 0, y == 10) resultfp3
resultf := face(resultfp0, resultfp1, resultfp2, resultfp3, -> close)
result := solid(resultf, from: -1mm, to: 0mm)
view(result) in front
