unit mm
o := point hint(x: 0, y: 0)
ground o
q := point hint(x: 40, y: 0)
ground q
front := plane(origin:o,toward:q)
resultfp0 := point hint(x: 0, y: 0) in front
ground resultfp0
resultfp1 := point hint(x: 10, y: 0) in front
ground resultfp1
resultfp2 := point hint(x: 10, y: 10) in front
ground resultfp2
resultfp3 := point hint(x: 0, y: 10) in front
ground resultfp3
resultf := face(resultfp0, resultfp1, resultfp2, resultfp3, -> close)
result := solid(resultf, from: -1mm, to: 0mm)
view(result) in front
