unit mm
o := point hint(x: 0, y: 0)
ground o
q := point hint(x: 40, y: 0)
ground q
front := plane(origin:o,toward:q)
stockfp0 := point hint(x: 0, y: 0)
ground stockfp0
stockfp1 := point hint(x: 10, y: 0)
ground stockfp1
stockfp2 := point hint(x: 10, y: 10)
ground stockfp2
stockfp3 := point hint(x: 0, y: 10)
ground stockfp3
stockf := face(stockfp0, stockfp1, stockfp2, stockfp3, -> close)
stock := solid(stockf, from: -0.1mm, to: 0mm)
bossfp0 := point hint(x: 2, y: 2)
ground bossfp0
bossfp1 := point hint(x: 5, y: 2)
ground bossfp1
bossfp2 := point hint(x: 5, y: 5)
ground bossfp2
bossfp3 := point hint(x: 2, y: 5)
ground bossfp3
bossf := face(bossfp0, bossfp1, bossfp2, bossfp3, -> close)
boss := solid(bossf, from: 1mm, to: 2mm)
result := solid(stock)
boss union result
back := plane(origin:o,toward:q,u:(-1,0,0),v:(0,0,1))
view(result) in back
