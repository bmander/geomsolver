unit mm
o := point hint(x: 0, y: 0)
ground o
q := point hint(x: 40, y: 0)
ground q
front := plane(origin:o,toward:q)
stockfp0 := point hint(x: 0, y: 0)
ground stockfp0
stockfp1 := point hint(x: 10, y: 0)
ground stockfp1
stockfp2 := point hint(x: 10, y: 10)
ground stockfp2
stockfp3 := point hint(x: 0, y: 10)
ground stockfp3
stockf := face(stockfp0, stockfp1, stockfp2, stockfp3, -> close)
stock := solid(stockf, from: -1mm, to: 0mm)
fp := point hint(x: 20, y: 20)
ground fp
fc := circle(center: fp) hint(r: 2)
radius(2mm) fc
f := face(fc)
tool := solid(f,depth:1mm)
result := solid(stock)
dimensions(result) in front
