model m from "solid_elbow.sv"

sheet elbow {
  size (297mm, 210mm)
  label "HOLLOW DUCT ELBOW" at (14mm, 18mm)
  label "Hollow section / constrained arc guide / implicit end section" at (14mm, 28mm)
  label "FRONT" at (42mm, 42mm)
  label "PLAN" at (42mm, 104mm)
  label "ISOMETRIC" at (175mm, 42mm)
  view front(m.body) from front at (32mm, 80mm) scale 1.3
  view plan(m.body) from top at (32mm, 150mm)
  view iso(m.body) from isometric at (175mm, 120mm) scale 1.8
  dimensions in front
  style .hidden { color: #a1aab4; dash: 3 3 }
  label "Change bend_angle for a different length of bend." at (145mm, 192mm)
}
