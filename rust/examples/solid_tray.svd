model m from "solid_tray.sv"

sheet tray {
  size (297mm, 210mm)
  label "POCKETED TRAY" at (14mm, 18mm)
  label "Named contours / blind pocket / nested bodies / annular standoffs" at (14mm, 28mm)
  label "OPEN FACE" at (42mm, 42mm)
  label "SIDE" at (42mm, 134mm)
  label "ISOMETRIC" at (175mm, 42mm)
  view front(m.body) from front at (64mm, 90mm) scale 1.3
  view side(m.body) from right at (64mm, 170mm)
  view iso(m.body) from isometric at (205mm, 120mm) scale 1.8
  dimensions in side
  style .hidden { color: #a1aab4; dash: 3 3 }
  label "Pocket first, then bosses: the inner floor remains intact." at (145mm, 192mm)
}
