model m from "solid_pulley.sv"

sheet pulley {
  size (297mm, 210mm)
  label "V-BELT PULLEY" at (14mm, 18mm)
  label "Stepped radial section / full revolution / revolved groove cut" at (14mm, 28mm)
  label "FRONT" at (42mm, 42mm)
  label "END" at (42mm, 130mm)
  label "ISOMETRIC" at (175mm, 42mm)
  view front(m.body) from front at (64mm, 85mm) scale 1.3
  view end(m.body) from top at (64mm, 165mm)
  view iso(m.body) from isometric at (205mm, 120mm) scale 1.8
  dimensions in front
  style .hidden { color: #a1aab4; dash: 3 3 }
  label "The radial profile includes the hub and shaft bore." at (145mm, 192mm)
}
