// Presentation of tetrahedron_grown.sv. Model geometry is independent of this drawing.
model m from "tetrahedron_grown.sv"

sheet grown {
  size (297mm, 210mm)
  label "A TETRAHEDRON GROWN" at (14mm, 18mm)
  label "conv{a, b, c, d} grown by 1: the points a ball of 1 about some point of the hull reaches" at (14mm, 28mm)
  label "FRONT" at (40mm, 52mm)
  label "ISOMETRIC" at (175mm, 52mm)
  view front(m.grown) from front at (70mm, 115mm) scale 6
  view iso(m.grown) from isometric at (200mm, 115mm) scale 6
  style .hidden { color: #a1aab4; dash: 3 3 }
  label "Each face moved out, each edge a cylinder's sector, each corner a ball's." at (24mm, 185mm)
}
