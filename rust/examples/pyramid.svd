// Presentation of pyramid.sv. Model geometry is independent of this drawing.
model m from "pyramid.sv"

sheet pyramid {
  size (297mm, 210mm)
  label "A PYRAMID" at (14mm, 18mm)
  label "Its apex joined to its base: the points on a segment from the apex to some point of the base" at (14mm, 28mm)
  label "BASE" at (40mm, 52mm)
  label "ISOMETRIC" at (175mm, 52mm)
  sketch base(m) from m.std.top at (80mm, 120mm) scale 3
  view iso(m.pyramid) from isometric at (210mm, 125mm) scale 3
  style .hidden { color: #a1aab4; dash: 3 3 }
  label "Edit w or h and the pyramid follows: its volume w² h / 3." at (24mm, 185mm)
}
