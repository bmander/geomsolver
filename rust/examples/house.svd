// Presentation of house.sv. Model geometry is independent of this drawing.
model m from "house.sv"

sheet house {
  size (297mm, 210mm)
  label "A HOUSE" at (14mm, 18mm)
  label "A box joined to a peak over it, and the same box grown by a ball" at (14mm, 28mm)
  label "HOUSE" at (40mm, 52mm)
  label "ROUNDED" at (175mm, 52mm)
  view house(m.house) from isometric at (66mm, 142mm) scale 3
  view rounded(m.rounded) from isometric at (112mm, 191mm) scale 3
  style .hidden { color: #a1aab4; dash: 3 3 }
  label "Move the peak, or edit the box, and both follow." at (24mm, 185mm)
}
