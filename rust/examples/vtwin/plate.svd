// Three projections of the solved part, arranged independently of its model.
model m from "components/frame.sv"

sheet part {
  size A4
  view front(m.plate.body) from front at (60mm, 150mm)
  view right(m.plate.body) from right at (140mm, 150mm)
  view top(m.plate.body) from top at (60mm, 65mm)
  dimensions in front
  dimensions in right
  style .hidden { dash: 4 3; color: #888888 }
}
