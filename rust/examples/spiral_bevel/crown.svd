model m from "hypoid.sv"

sheet crown {
  size (297mm, 210mm)
  style m.tooth.crown { display: inline }
  label "CROWN TOOTH" at (14mm, 18mm)
  label "Flank cones through the pitch points / tangent tip roundings" at (14mm, 28mm)
  view meridian(m.tooth.crown) from front at (52mm, 74mm) scale 2.6
  view iso(m.tooth.crown) from isometric at (145mm, 180mm) scale 1.3
  label "The generating crown of the spiral bevel pair (hypoid.sv); not the finished gear." at (14mm, 192mm)
}
