model m from "crown/section.sv"

sheet crown {
  size (297mm, 210mm)
  label "CROWN TOOTH" at (14mm, 18mm)
  label "Straight flanks at the pressure angle / tangent tip roundings" at (14mm, 28mm)
  view meridian(m.crown) from front at (145mm, 74mm) scale 2.6
  view iso(m.crown) from isometric at (145mm, 140mm) scale 1.3
  label "The generating crown of the spiral bevel pair (crown/section.sv); not the finished gear." at (14mm, 192mm)
}
