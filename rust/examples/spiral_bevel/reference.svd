model m from "reference.sv"

sheet reference {
  size (297mm, 210mm)
  label "REFERENCE CROWN GEOMETRY" at (14mm, 18mm)
  label "Constrained flank angles / tangent circular root generators" at (14mm, 28mm)
  view meridian(m.crown) from front at (145mm, 74mm) scale 2.6
  view iso(m.crown) from isometric at (145mm, 140mm) scale 1.3
  label "Construction for the spiral bevel pair; not the finished gear." at (14mm, 192mm)
}
