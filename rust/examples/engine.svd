// Presentation of engine.sv. Model geometry is independent of this drawing.
model m from "engine.sv"

// The side view is the front plane; the end view stands 620 to the right of it and the plan 620
// above it, each in its own plane's coordinates.
sheet drawing {
  size A3
  sketch side(m) at (80mm, 180mm)
  sketch end(m) from m.std.side at (700mm, 180mm)
  sketch plan(m) from m.std.top at (80mm, -440mm)
  // section A-A through rod 1's shank, in the plane the rod cuts it in, beside the plan
  sketch secA(m.rod1) from m.rod1.cut at (585mm, -440mm)
  style m.O { display: none }
  style m.end.top.p { display: none }
  style m.side.a0.p { display: none }
  style m.side.a1.p { display: none }
  style m.block.bl0 { display: none }
  style m.block.br0 { display: none }
  style m.block.bl1.p { display: none }
  style m.block.br1.p { display: none }
  style m.block.d_l { display: none }
  style m.block.d_r { display: none }
  style m.block.s_l.p { display: none }
  style m.block.s_r.p { display: none }
  style m.block.k_l.p { display: none }
  style m.block.k_r.p { display: none }
  style m.block.pr_l { display: none }
  style m.block.pr_r { display: none }
  style m.block.c_l { display: none }
  style m.block.c_r { display: none }
  style m.block.sh_l.p { display: none }
  style m.block.sh_r.p { display: none }
  style m.block.sp_l { display: none }
  style m.block.sp_r { display: none }
  style m.block.bfl { display: none }
  style m.block.bfr { display: none }
  style m.block.rfl { display: none }
  style m.block.rfr { display: none }
  style m.block.q_a { display: none }
  style m.block.q_b { display: none }
  style m.block.q_c { display: none }
  style m.block.q_d { display: none }
  style m.block.q_e { display: none }
  style m.block.fl { display: none }
  style m.block.fr { display: none }
  style m.block.br { display: none }
  style m.block.bl { display: none }
  style m.head.f_l { display: none }
  style m.head.f_r { display: none }
  style m.head.t_l { display: none }
  style m.head.tr.p { display: none }
  style m.head.r_l.p { display: none }
  style m.head.r_r.p { display: none }
  style m.head.ridge.p { display: none }
  style m.head.plug.a { display: none }
  style m.head.plug.b { display: none }
  style m.head.plug.c { display: none }
  style m.head.plug.d { display: none }
  style m.head.seat_i { display: none }
  style m.head.seat_e { display: none }
  style m.head.cam_i { display: none }
  style m.head.cam_e { display: none }
  style m.camshaft_i.lobe.n { display: none }
  style m.camshaft_i.lobe.br { display: none }
  style m.camshaft_i.lobe.bl { display: none }
  style m.camshaft_i.lobe.nr { display: none }
  style m.camshaft_i.lobe.nl { display: none }
  style m.camshaft_e.lobe.n { display: none }
  style m.camshaft_e.lobe.br { display: none }
  style m.camshaft_e.lobe.bl { display: none }
  style m.camshaft_e.lobe.nr { display: none }
  style m.camshaft_e.lobe.nl { display: none }
  style m.head.v_i.fc { display: none }
  style m.head.v_i.f1 { display: none }
  style m.head.v_i.f2 { display: none }
  style m.head.v_i.b1 { display: none }
  style m.head.v_i.b2 { display: none }
