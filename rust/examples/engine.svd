// Presentation of engine.sv. Model geometry is independent of this drawing.
model m from "engine.sv"

// The side view is the front plane; the end view stands 620 to the right of it and the plan 620
// above it, each in its own plane's coordinates.
sheet drawing {
  size A3
  sketch side(m) at (80mm, 180mm)
  sketch end(m) from m.std.side at (700mm, 180mm)
  sketch plan(m) from m.std.top at (80mm, -440mm)
  // section A-A through rod 1's shank, in the plane the rod cuts it in, beside the plan
  sketch secA(m.rod1) from m.rod1.cut at (585mm, -440mm)
  style m.O { display: none }
  style m.end.top.p { display: none }
  style m.side.a0.p { display: none }
  style m.side.a1.p { display: none }
  style m.block.bl0 { display: none }
  style m.block.br0 { display: none }
  style m.block.bl1.p { display: none }
  style m.block.br1.p { display: none }
  style m.block.d_l { display: none }
  style m.block.d_r { display: none }
  style m.block.s_l.p { display: none }
  style m.block.s_r.p { display: none }
  style m.block.k_l.p { display: none }
  style m.block.k_r.p { display: none }
  style m.block.pr_l { display: none }
  style m.block.pr_r { display: none }
  style m.block.c_l { display: none }
  style m.block.c_r { display: none }
  style m.block.sh_l.p { display: none }
  style m.block.sh_r.p { display: none }
  style m.block.sp_l { display: none }
  style m.block.sp_r { display: none }
  style m.block.bfl { display: none }
  style m.block.bfr { display: none }
  style m.block.rfl { display: none }
  style m.block.rfr { display: none }
  style m.block.q_a { display: none }
  style m.block.q_b { display: none }
  style m.block.q_c { display: none }
  style m.block.q_d { display: none }
  style m.block.q_e { display: none }
  style m.block.fl { display: none }
  style m.block.fr { display: none }
  style m.block.br { display: none }
  style m.block.bl { display: none }
  style m.head.f_l { display: none }
  style m.head.f_r { display: none }
  style m.head.t_l { display: none }
  style m.head.tr.p { display: none }
  style m.head.r_l.p { display: none }
  style m.head.r_r.p { display: none }
  style m.head.ridge.p { display: none }
  style m.head.plug.a { display: none }
  style m.head.plug.b { display: none }
  style m.head.plug.c { display: none }
  style m.head.plug.d { display: none }
  style m.head.seat_i { display: none }
  style m.head.seat_e { display: none }
  style m.head.cam_i { display: none }
  style m.head.cam_e { display: none }
  style m.head.lobe_i.n { display: none }
  style m.head.lobe_i.fl.a { display: none }
  style m.head.lobe_i.fl.b { display: none }
  style m.head.lobe_i.fr.a { display: none }
  style m.head.lobe_i.fr.b { display: none }
  style m.head.lobe_e.n { display: none }
  style m.head.lobe_e.fl.a { display: none }
  style m.head.lobe_e.fl.b { display: none }
  style m.head.lobe_e.fr.a { display: none }
  style m.head.lobe_e.fr.b { display: none }
  style m.head.v_i.fc { display: none }
  style m.head.v_i.f1 { display: none }
  style m.head.v_i.f2 { display: none }
  style m.head.v_i.b1 { display: none }
  style m.head.v_i.b2 { display: none }
  style m.head.v_i.hc { display: none }
  style m.head.v_i.h1 { display: none }
  style m.head.v_i.h2 { display: none }
  style m.head.v_e.fc { display: none }
  style m.head.v_e.f1 { display: none }
  style m.head.v_e.f2 { display: none }
  style m.head.v_e.b1 { display: none }
  style m.head.v_e.b2 { display: none }
  style m.head.v_e.hc { display: none }
  style m.head.v_e.h1 { display: none }
  style m.head.v_e.h2 { display: none }
  style m.head.hfl { display: none }
  style m.head.hfr { display: none }
  style m.head.htl { display: none }
  style m.head.htr { display: none }
  style m.head.cam { display: none }
  style m.head.camb { display: none }
  style m.head.ju0 { display: none }
  style m.head.ju1 { display: none }
  style m.head.jd0 { display: none }
  style m.head.jd1 { display: none }
  style m.head.hfl_t { display: none }
  style m.head.hfr_t { display: none }
  style m.head.hbr_t { display: none }
  style m.head.hbl_t { display: none }
  style m.head.ci { display: none }
  style m.head.ce { display: none }
  style m.head.ci1 { display: none }
  style m.head.ce1 { display: none }
  style m.drive.b1.a { display: none }
  style m.drive.b1.b { display: none }
  style m.drive.b2.a { display: none }
  style m.drive.b2.b { display: none }
  style m.drive.b3.a { display: none }
  style m.drive.b3.b { display: none }
  style m.drive_s.crankpulley.a { display: none }
  style m.drive_s.crankpulley.b { display: none }
  style m.drive_s.crankpulley.c { display: none }
  style m.drive_s.crankpulley.d { display: none }
  style m.drive_s.campulley.a { display: none }
  style m.drive_s.campulley.b { display: none }
  style m.drive_s.campulley.c { display: none }
  style m.drive_s.campulley.d { display: none }
  style m.end.bore { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.side.axisline { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.head.vaxis_i { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.head.vaxis_e { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.head.lobe_i.spine { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.head.lobe_e.spine { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.head.camline { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.head.cl_i { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.head.cl_e { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.drive.b1.s { color: #2a7ab0; width: 1.2 }
  style m.drive.b2.s { color: #2a7ab0; width: 1.2 }
  style m.drive.b3.s { color: #2a7ab0; width: 1.2 }
  style m.drive_s.beltf { color: #2a7ab0; width: 1.2 }
  style m.drive_s.beltb { color: #2a7ab0; width: 1.2 }
  style m.block.shell { color: #7a7a7a; width: 0.6; dash: 4 3 }
  style m.head.j_i { color: #7a7a7a; width: 0.6; dash: 4 3 }
  style m.head.j_e { color: #7a7a7a; width: 0.6; dash: 4 3 }
  // every rod draws itself in both sections: the end section shows cylinder 1's, and ghosts
  // cylinder 2's a half turn on (3's and 4's stand where 2's and 1's do)
  style m.rod2 in end { color: #888888; width: 0.6; dash: 6 3 }
  style m.rod3 in end { display: none }
  style m.rod4 in end { display: none }
  style m.drive.pcrank { color: #2a7ab0; width: 1.2 }
  style m.drive.pcam_i { color: #2a7ab0; width: 1.2 }
  style m.drive.pcam_e { color: #2a7ab0; width: 1.2 }
  // the block and its oil pan (`engine/block.sv`): the points of the pan's wall, flange and
  // bolts, its drain, and the water jacket, hidden; the drain plug's hole drawn hidden
  style m.block.jl0.p { display: none }
  style m.block.jl1.p { display: none }
  style m.block.jl2.p { display: none }
  style m.block.jl3.p { display: none }
  style m.block.jr0.p { display: none }
  style m.block.jr1.p { display: none }
  style m.block.jr2.p { display: none }
  style m.block.jr3.p { display: none }
  style m.block.lo_l.p { display: none }
  style m.block.lo_r.p { display: none }
  style m.block.li_l.p { display: none }
  style m.block.li_r.p { display: none }
  style m.block.it_l { display: none }
  style m.block.it_r { display: none }
  style m.block.ih_l { display: none }
  style m.block.ih_r { display: none }
  style m.block.ip_l { display: none }
  style m.block.ip_r { display: none }
  style m.block.bolt_l.a { display: none }
  style m.block.bolt_l.b { display: none }
  style m.block.bolt_l.c { display: none }
  style m.block.bolt_l.d { display: none }
  style m.block.bolt_r.a { display: none }
  style m.block.bolt_r.b { display: none }
  style m.block.bolt_r.c { display: none }
  style m.block.bolt_r.d { display: none }
  style m.block.pf_f.p { display: none }
  style m.block.pf_b.p { display: none }
  style m.block.it_a { display: none }
  style m.block.j_b { display: none }
  style m.block.j_c { display: none }
  style m.block.j_d { display: none }
  style m.block.it_e { display: none }
  style m.block.db0.p { display: none }
  style m.block.db1.p { display: none }
  style m.block.db2.p { display: none }
  style m.block.db3.p { display: none }
  style m.block.dh0.p { display: none }
  style m.block.dh1.p { display: none }
  style m.block.dh2.p { display: none }
  style m.block.dh3.p { display: none }
  style m.block.jk0.p { display: none }
  style m.block.jk1.p { display: none }
  style m.block.jk2.p { display: none }
  style m.block.jk3.p { display: none }
  style m.block.drain_f { color: #7a7a7a; width: 0.6; dash: 4 3 }
  style m.block.drain_b { color: #7a7a7a; width: 0.6; dash: 4 3 }
  // the pistons (`engine.parts.Piston`): what each outline hides, dashed — the dish, the hollow,
  // the bosses and the gudgeon pin — and the end view's corners and centres out of the way
  style m.piston1.hidden { color: #7a7a7a; width: 0.6; dash: 4 3 }
  style m.pistons1.hidden { color: #7a7a7a; width: 0.6; dash: 4 3 }
  style m.pistons2.hidden { color: #7a7a7a; width: 0.6; dash: 4 3 }
  style m.pistons3.hidden { color: #7a7a7a; width: 0.6; dash: 4 3 }
  style m.pistons4.hidden { color: #7a7a7a; width: 0.6; dash: 4 3 }
  style m.piston1.cl { display: none }
  style m.piston1.hidden.dl { display: none }
  style m.piston1.hidden.dr { display: none }
  style m.piston1.hidden.db { display: none }
  style m.piston1.hidden.dc { display: none }
  style m.piston1.hidden.w0 { display: none }
  style m.piston1.hidden.k0 { display: none }
}
