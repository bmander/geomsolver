  style m.head.hbl_t { display: none }
  style m.head.ci { display: none }
  style m.head.ce { display: none }
  style m.head.ci1 { display: none }
  style m.head.ce1 { display: none }
  style m.end.bore { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.side.axisline { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.head.vaxis_i { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.head.vaxis_e { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.camshaft_i.lobe.spine { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.camshaft_e.lobe.spine { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.head.camline { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.head.cl_i { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.head.cl_e { color: #888888; width: 0.5; dash: 14 3 2 3 }
  style m.block.shell { color: #7a7a7a; width: 0.6; dash: 4 3 }
  style m.head.j_i { color: #7a7a7a; width: 0.6; dash: 4 3 }
  style m.head.j_e { color: #7a7a7a; width: 0.6; dash: 4 3 }
  // every rod draws itself in both sections: the end section shows cylinder 1's, and ghosts
  // cylinder 2's a half turn on (3's and 4's stand where 2's and 1's do)
  style m.rod2 in end { color: #888888; width: 0.6; dash: 6 3 }
  style m.rod3 in end { display: none }
  style m.rod4 in end { display: none }
  // the block and its oil pan (`engine/block.sv`): the points of the pan's wall, flange and
  // bolts, its drain, and the water jacket, hidden; the drain plug's hole drawn hidden
  style m.block.jl0.p { display: none }
  style m.block.jl1.p { display: none }
  style m.block.jl2.p { display: none }
  style m.block.jl3.p { display: none }
  style m.block.jr0.p { display: none }
  style m.block.jr1.p { display: none }
  style m.block.jr2.p { display: none }
  style m.block.jr3.p { display: none }
