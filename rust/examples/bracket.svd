// Presentation of bracket.sv. Model geometry is independent of this drawing.
model m from "bracket.sv"

// Third-angle layout: the top view above the front, the right view beside it, and the auxiliary
// view out along the incline, each drawn in its own plane's coordinates.
sheet drawing {
  size A3
  sketch front(m) at (80mm, 180mm)
  sketch top(m) from m.std.top at (80mm, 90mm)
  sketch right(m) from m.std.side at (230mm, 180mm)
  sketch aux(m) from m.aux at (10mm, 110mm)
  dimensions in front
  dimensions in top
  dimensions in right
  dimensions in aux
  style m.toe_r { color: #7a7a7a; dash: 3 3 }
}
